#!/usr/bin/env bash
# Acceptance tests for transitvpn scaffold.
# NOTE: the acceptance gate runs each non-comment line INDEPENDENTLY via `sh -c`
# (not bash), and each line must exit 0 AND print real output to stdout. Keep
# every line POSIX-sh compatible: no `$'...'` ANSI-C quoting, and no `grep -q`
# (it suppresses output, which the gate reads as "produced nothing").

python -m py_compile transitvpn/__init__.py transitvpn/cli.py && echo "PASS: py_compile"

python -c "from transitvpn.cgnat import CgnatStatus, CgnatResult, detect_cgnat; from transitvpn.keygen import Keys, generate_keys; from transitvpn.config import VlessConfig, ShadowsocksConfig, RelayConfig; from transitvpn.server import build_xray_config, build_ss_config; from transitvpn.cli import build_parser, main; print('PASS: imports')"

python transitvpn/cli.py --help
echo "PASS: --help"

python transitvpn/cli.py --version
echo "PASS: --version"

python transitvpn/cli.py up 2>&1 | grep "up:" || exit 1
echo "PASS: subcommand up"

python transitvpn/cli.py up 2>&1 | grep "up: error:" || exit 1
echo "PASS: up prints error without config"

python transitvpn/cli.py down 2>&1 | grep "down:" || exit 1
echo "PASS: subcommand down"

python transitvpn/cli.py status 2>&1 | grep "status:" || exit 1
echo "PASS: subcommand status"

python transitvpn/cli.py bootstrap --dry-run 2>&1 | grep "cgnat:" || exit 1
echo "PASS: bootstrap --dry-run"

python transitvpn/cli.py bootstrap --dry-run | grep -c "$(printf '\033')"
echo "PASS: QR codes printed"

python transitvpn/cli.py keygen 2>&1 | grep "vless_uuid" || exit 1
echo "PASS: keygen"

echo "All acceptance checks passed."
